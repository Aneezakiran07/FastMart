<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:background="@color/button_dark"
    android:orientation="vertical"
    android:gravity="bottom"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDrawerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seller"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvDrawerEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="seller@email.com"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Colour Scheme"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLightTheme"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Light"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/white"
            android:textColor="@color/button_dark"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnDarkTheme"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Dark"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/button_dark"
            android:textColor="@color/white"
            />

    </LinearLayout>

</LinearLayout>