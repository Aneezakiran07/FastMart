<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:background="@color/white">

    <ImageView
        android:id="@+id/ivProduct"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:scaleType="fitCenter"
        android:background="@drawable/input_background"
        android:padding="6dp"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <!-- price with strikethrough original -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/price_red"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvOriginalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/strikethrough_gray"
                android:textSize="12sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:maxLines="2"/>

        <TextView
            android:id="@+id/tvModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

        <!-- quantity controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnDecrease"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="@string/btn_decrease"
                android:textSize="18sp"
                android:gravity="center"
                android:textColor="@color/white"
                android:background="@color/button_dark"/>

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginHorizontal="6dp"/>

            <TextView
                android:id="@+id/btnIncrease"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="@string/btn_increase"
                android:textSize="18sp"
                android:gravity="center"
                android:textColor="@color/white"
                android:background="@color/button_dark"/>

        </LinearLayout>

    </LinearLayout>

    <!-- three dot on top right -->
    <ImageView
        android:id="@+id/ivMoreOptions"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top"
        android:src="@drawable/ic_more_vert"
        android:contentDescription="@null"/>

</LinearLayout>